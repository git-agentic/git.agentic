---
import type { MarkdownInstance } from 'astro';
import Base from '../../layouts/Base.astro';
import { articles, articleUrl, formatDate, type Article } from '../../data/articles';

type MarkdownModule = MarkdownInstance<Record<string, unknown>>;

export function getStaticPaths() {
  const modules = import.meta.glob<MarkdownModule>('../../../../blog/*.md', { eager: true });

  return articles.map((article) => {
    const moduleEntry = Object.entries(modules).find(([path]) => path.endsWith(`/${article.source}`));
    if (!moduleEntry) {
      throw new Error(`Missing article source: ${article.source}`);
    }

    return {
      params: { slug: article.slug },
      props: { article, Content: moduleEntry[1].Content },
    };
  });
}

interface Props {
  article: Article;
  Content: MarkdownModule['Content'];
}

const { article, Content } = Astro.props;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://git-agentic.com/' },
    { '@type': 'ListItem', position: 2, name: 'Learn', item: 'https://git-agentic.com/learn' },
    {
      '@type': 'ListItem',
      position: 3,
      name: article.title,
      item: `https://git-agentic.com${articleUrl(article)}`,
    },
  ],
};
---
<Base
  title={`${article.title} | git.agentic`}
  description={article.description}
  type="article"
  publishedTime={article.published}
  modifiedTime={article.modified}
  structuredData={structuredData}
>
  <div class="wrap article-wrap">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        <li><a href="/learn">Learn</a></li>
        <li aria-current="page">{article.title}</li>
      </ol>
    </nav>

    <article class="article">
      <p class="article__meta">
        Published <time datetime={article.published}>{formatDate(article.published)}</time>.
        Updated <time datetime={article.modified}>{formatDate(article.modified)}</time>.
        By Toni Bergholm.
      </p>
      <Content />
    </article>

    <aside class="card article__next" aria-label="Next steps">
      <p>
        The implementation and the runnable broken-prompt demo are on
        <a href="https://github.com/git-agentic/git.agentic">GitHub</a>.
      </p>
      <p><a href="/learn">All guides</a></p>
    </aside>
  </div>
</Base>
