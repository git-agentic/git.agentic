---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import { articles, articleUrl, formatDate } from '../../data/articles';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'AI agent infrastructure guides',
  description: 'Technical guides to version control, rollback, and infrastructure for AI agents.',
  url: 'https://git-agentic.com/learn',
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: article.title,
      url: `https://git-agentic.com${articleUrl(article)}`,
    })),
  },
};
---
<Base
  title="AI Agent Version Control & Infrastructure Guides | git.agentic"
  description="Technical guides to version control, atomic rollback, memory snapshots, and infrastructure for production AI agents."
  modifiedTime="2026-11-20"
  structuredData={structuredData}
>
  <div class="hero">
    <div class="wrap">
      <p class="eyebrow">Learn</p>
      <h1>Version control and infrastructure for AI agents.</h1>
      <p class="lead">
        Technical explanations of why agent behavior is wider than code, what
        a coherent rollback must restore, and how a commit changes when agents
        write and operate software.
      </p>
    </div>
  </div>

  <Section id="guides" title="Guides" note="Four articles, also available as an RSS feed.">
    <ul class="article-list">
      {articles.map((article) => (
        <li>
          <time datetime={article.published}>{formatDate(article.published)}</time>
          <a href={articleUrl(article)}>{article.title}</a>
          <p>{article.description}</p>
        </li>
      ))}
    </ul>
    <p><a href="/rss.xml">Subscribe by RSS</a></p>
  </Section>
</Base>
