---
import Section from './Section.astro';
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<Section id="faq" title="Frequently asked questions">
  <dl class="faq">
    {items.map((item) => (
      <div>
        <dt>{item.question}</dt>
        <dd>{item.answer}</dd>
      </div>
    ))}
  </dl>
</Section>
