---
interface Item {
  question: string;
  answer: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<section aria-labelledby="frequently-asked-questions">
  <h2 id="frequently-asked-questions">Frequently asked questions</h2>
  <dl class="faq-list">
    {items.map((item) => (
      <>
        <dt>{item.question}</dt>
        <dd>{item.answer}</dd>
      </>
    ))}
  </dl>
</section>
