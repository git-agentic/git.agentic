---
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'git.agentic — Git for agent behavior',
  description = 'Atomic, reversible snapshots of the full system state — code, prompts, tools, model, memory, schema — that determines how an AI agent acts.',
} = Astro.props;
const canonical = new URL(
  Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'),
  Astro.site,
).toString();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style is:global>
      :root {
        --bg: #0b0d10;
        --bg-soft: #11141a;
        --bg-hard: #07080a;
        --fg: #e6e8eb;
        --fg-mute: #9aa3ad;
        --fg-faint: #5a626c;
        --rule: #1c2128;
        --accent: #ff7a45;       /* the "rollback" orange */
        --accent-soft: #ffb38a;
        --ok: #6ee7a3;
        --bad: #ff6b6b;
        --mono: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace;
        --sans: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      }
      * { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        background: var(--bg);
        color: var(--fg);
        font-family: var(--mono);
        font-size: 15px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; text-underline-offset: 3px; }
      ::selection { background: var(--accent); color: var(--bg-hard); }

      main {
        max-width: 760px;
        margin: 0 auto;
        padding: 4rem 1.5rem 6rem;
      }
      header.site {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 4rem;
      }
      header.site .brand {
        font-weight: 600;
        letter-spacing: -0.01em;
        color: var(--fg);
      }
      header.site .brand .dot { color: var(--accent); }
      header.site .brand a { color: var(--fg); }
      header.site .brand a:hover { text-decoration: none; }
      header.site nav {
        display: flex;
        gap: 1.25rem;
        font-size: 13px;
        flex-wrap: wrap;
      }
      header.site nav a {
        color: var(--fg-mute);
      }
      header.site nav a:hover { color: var(--fg); text-decoration: none; }

      h1, h2, h3 {
        font-family: var(--sans);
        font-weight: 600;
        letter-spacing: -0.02em;
        color: var(--fg);
        margin: 0;
      }
      h1 {
        font-size: 2.4rem;
        line-height: 1.1;
        margin-bottom: 1rem;
      }
      h2 {
        font-size: 1.05rem;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--fg-mute);
        margin-top: 4rem;
        margin-bottom: 1.25rem;
        font-weight: 500;
      }
      h3 {
        font-size: 1rem;
        margin-top: 1.5rem;
        margin-bottom: 0.5rem;
      }
      p { margin: 0 0 1rem; }
      p.lead {
        font-family: var(--sans);
        font-size: 1.2rem;
        line-height: 1.45;
        color: var(--fg);
        margin-bottom: 1.5rem;
        max-width: 56ch;
      }
      .mute { color: var(--fg-mute); }
      .faint { color: var(--fg-faint); }

      pre, code {
        font-family: var(--mono);
        font-size: 13px;
      }
      pre {
        background: var(--bg-hard);
        border: 1px solid var(--rule);
        border-radius: 6px;
        padding: 1rem 1.1rem;
        overflow-x: auto;
        margin: 1rem 0 1.5rem;
        line-height: 1.55;
      }
      code {
        background: var(--bg-soft);
        padding: 0.1rem 0.35rem;
        border-radius: 3px;
        color: var(--accent-soft);
      }
      pre code {
        background: transparent;
        padding: 0;
        color: inherit;
      }
      .ok { color: var(--ok); }
      .bad { color: var(--bad); }
      .accent { color: var(--accent); }
      .comment { color: var(--fg-faint); }

      table.tuple {
        width: 100%;
        border-collapse: collapse;
        margin: 1rem 0 1.5rem;
        font-size: 13px;
      }
      table.tuple th, table.tuple td {
        text-align: left;
        padding: 0.55rem 0.75rem;
        border-bottom: 1px solid var(--rule);
        vertical-align: top;
      }
      table.tuple th {
        font-weight: 500;
        color: var(--fg-mute);
        text-transform: uppercase;
        letter-spacing: 0.08em;
        font-size: 11px;
      }
      table.tuple td:first-child { color: var(--accent-soft); width: 9rem; }

      .badges {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
        margin-bottom: 2rem;
        font-size: 12px;
      }
      .badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.2rem 0.55rem;
        border: 1px solid var(--rule);
        border-radius: 999px;
        color: var(--fg-mute);
      }
      .badge .pulse {
        width: 7px; height: 7px;
        background: var(--accent);
        border-radius: 50%;
      }

      hr.rule {
        border: 0;
        border-top: 1px solid var(--rule);
        margin: 4rem 0 2rem;
      }

      footer.site {
        font-size: 12px;
        color: var(--fg-faint);
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
      }
      footer.site a { color: var(--fg-mute); }

      ul.plain { list-style: none; padding: 0; margin: 0 0 1rem; }
      ul.plain li { padding: 0.25rem 0; }
      ul.plain li::before {
        content: "→ ";
        color: var(--fg-faint);
        margin-right: 0.25rem;
      }

      @media (max-width: 540px) {
        main { padding: 2rem 1.1rem 4rem; }
        h1 { font-size: 1.9rem; }
        p.lead { font-size: 1.05rem; }
        header.site { flex-direction: column; align-items: flex-start; gap: 0.6rem; margin-bottom: 2.5rem; }
        pre { font-size: 12px; }
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
